#!/bin/sh

FORCE_REBUILD=0

print_help() {
	printf "Usage: $0 [options]\n"
	printf "Options:\n"
	printf "  --force-rebuild            Force rebuild of the pianoberry-build image.\n"
	printf "  --help                     Show this help message.\n"
}

while [ $# -gt 0 ]; do
	case "$1" in
		--force-rebuild)
			FORCE_REBUILD=1
			;;
		--help)
			print_help
			exit 0
			;;
		*)
			printf "***************************\n"
			printf "* Error: Invalid argument.*\n"
			printf "***************************\n\n"
			print_help
			exit 1
	esac
	shift
done

if [ "$FORCE_REBUILD" -eq 1 ]; then
  docker rmi -f pianoberry-build >/dev/null 2>&1 || true
fi

echo "Building pianoberry-build image"
if [ "$FORCE_REBUILD" -eq 1 ]; then
  docker build --no-cache -q -t pianoberry-build .
else
  docker build -q -t pianoberry-build .
fi

mkdir -p deploy

docker run --rm -it -v ./deploy:/build pianoberry-build:latest
