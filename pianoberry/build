#!/bin/sh

# Ensure this script is running inside the Docker build container
if [ ! -f /.dockerenv ] && [ ! -d /build ]; then
	echo "Error: This script is intended to run inside the Docker container."
	echo "Please run './build' from the repository root directory instead:"
	echo "  cd .. && ./build"
	exit 1
fi

URL="http://repo.tinycorelinux.net"

PACKAGES="
	alsa.tcz
	bzip2-lib.tcz
	expat2.tcz
	freetype.tcz
	glib2.tcz
	graphite2.tcz
	harfbuzz.tcz
	libasound.tcz
	libdrm.tcz
	libGLES.tcz
	liblzma.tcz
	libpng.tcz
	libX11.tcz
	libXau.tcz
	libXaw.tcz
	libxcb.tcz
	libXdmcp.tcz
	libXext.tcz
	libXfixes.tcz
	libxshmfence.tcz
	libxml2.tcz
	libXxf86vm.tcz
	libzstd.tcz
	llvm19-lib.tcz
	mesa.tcz
	pcre2.tcz
	fontconfig.tcz
"

echo "Building with:"
echo "  serial: ${PIANOTEQ_SERIAL}"
echo "  initial preset: ${PIANOTEQ_INITIAL_PRESET}"

mkdir -p /build/src
cd /build/src

download_file() {
	filename="${1##*/}"
	is_optional="$2"
	if [ ! -f "$filename" ]; then
		if [ "$is_optional" = "1" ]; then
			# Quietly attempt optional download (e.g. .tree file)
			if ! wget -q "${1}"; then
				rm -f "$filename"
				return 1
			fi
		else
			echo "Downloading ${1}"
			if ! wget "${1}"; then
				echo "Failed to download ${1}"
				rm -f "$filename"
				exit 1
			fi
		fi
	else
		echo "${filename} already exists, skipping download"
	fi
}

download_tcz() {
	download_file ${URL}/15.x/aarch64/tcz/${1}.tree 1

	if [ $? -ne 0 ]; then
		download_file ${URL}/15.x/aarch64/tcz/${1}
		return
	fi

	for file in `cat ${1}.tree`; do
		download_file ${URL}/15.x/aarch64/tcz/${file}

		# Check if the file ends with "v8.tcz"
		if echo "${file}" | grep -q "v8.tcz$"; then
			# Replace "v8.tcz" with "v8-16k.tcz" and download the additional file
			additional_file=$(echo "${file}" | sed 's/v8\.tcz$/v8-16k.tcz/')
			download_file ${URL}/15.x/aarch64/tcz/${additional_file}
		fi
	done
}

download_file ${URL}/15.x/aarch64/releases/RPi/piCore64-15.0.0.zip

for package in $PACKAGES; do
	download_tcz $package
done

cd /pianoberry/pianoberry

unzip -q -o /build/src/piCore64-15.0.0.zip

mkdir -p p1_dir p2_dir

# Extract partitions from piCore64 base image in userspace using 7z
7z e -y piCore64-15.0.0.img 0.fat 1.img >/dev/null
7z x -y -op1_dir 0.fat >/dev/null
7z x -y -op2_dir 1.img >/dev/null
rm -f 0.fat 1.img piCore64-15.0.0.img

# Remove stock piCore mydata.tgz so it does not overwrite our bootlocal.sh or configs at boot!
rm -f p2_dir/tce/mydata.tgz
> p2_dir/tce/onboot.lst

# Set hostname
printf ' pianoberry' >> p1_dir/cmdline.txt

cd /build/src

install_tcz() {
	if [ ! -f "${1}.tree" ]; then
		echo "Installing ${1}"
		cp ${1}* /pianoberry/pianoberry/p2_dir/tce/optional/
		return
	fi

	for file in `cat ${1}.tree`; do
		if [ -f "/pianoberry/pianoberry/p2_dir/tce/optional/${file}" ]; then
			continue
		fi

		echo "Installing ${file}"
		cp ${file}* /pianoberry/pianoberry/p2_dir/tce/optional/

		if echo "${file}" | grep -q "v8.tcz$"; then
			additional_file=$(echo "${file}" | sed 's/v8\.tcz$/v8-16k.tcz/')
			echo "Installing ${additional_file}"
			cp ${additional_file}* /pianoberry/pianoberry/p2_dir/tce/optional/
		fi
	done
}

mkdir -p /pianoberry/pianoberry/p2_dir/tce/optional

# Install the required extensions
for package in $PACKAGES; do
	install_tcz $package
done

# Enable the installed extensions
echo openssh.tcz >> /pianoberry/pianoberry/p2_dir/tce/onboot.lst
for package in $PACKAGES; do
	echo $package >> /pianoberry/pianoberry/p2_dir/tce/onboot.lst
done

echo alsa-modules-6.6.47-piCore-v8-16k.tcz >> /pianoberry/pianoberry/p2_dir/tce/onboot.lst

# Disable internal sound card in config.txt (Pisound HAT is auto-detected via its on-board EEPROM)
sed -i 's/dtparam=audio=on/#dtparam=audio=on/g' /pianoberry/pianoberry/p1_dir/config.txt

# Unpack the rootfs
mkdir -p /pianoberry/pianoberry/tempdir
cd /pianoberry/pianoberry/tempdir
zcat ../p1_dir/rootfs-piCore64-15.0.gz | cpio -idm

# Add Pianoteq configs
mkdir -p root/.config/Modartt
mkdir -p root/.local/share/Modartt/Pianoteq/MidiMappings
mkdir -p usr/local/share/pianoberry

# Install master preferences template and MIDI mapping
install -m 644 ../Pianoteq.prefs usr/local/share/pianoberry/Pianoteq.prefs
install -m 644 ../midi-map.ptm usr/local/share/pianoberry/midi-map.ptm
install -m 644 ../midi-map.ptm root/.local/share/Modartt/Pianoteq/MidiMappings/

# Add Pianoteq binary (support any 8/9 binary: Stage, Pro, Standard, or versioned)
for bin in "../Pianoteq "[89]*; do
	if [ -f "$bin" ]; then
		install -m 755 "$bin" usr/bin/Pianoteq
		break
	fi
done

# Dynamically derive prefs filename from binary version if present
if [ -f usr/bin/Pianoteq ]; then
	VERSION_STR=$(strings usr/bin/Pianoteq 2>/dev/null | grep -E '^Pianoteq [0-9]+\.[0-9]+' | head -n1 | grep -oE '[0-9]+\.[0-9]+')
	if [ -n "$VERSION_STR" ]; then
		VER_TAG=$(echo "$VERSION_STR" | tr -d '.')
		install -m 644 ../Pianoteq.prefs "root/.config/Modartt/Pianoteq${VER_TAG}.prefs"
	fi
fi

# Add Pianoteq startup script
install -m 755 ../startup.sh usr/bin/

# Configure ALSA default to Pisound hardware hw:pisound,0 (immune to USB card numbering)
mkdir -p etc
cat << 'EOF' > etc/asound.conf
pcm.!default {
   type plug
   slave.pcm "hw:pisound,0"
}
ctl.!default {
   type hw
   card pisound
}
EOF

# Start Pianoteq on boot
mkdir -p opt
cat << 'EOF' > opt/bootlocal.sh
#!/bin/sh
export HOME="/root"
export USER="root"
export XDG_CONFIG_HOME="/root/.config"
export XDG_DATA_HOME="/root/.local/share"
echo ondemand > /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor

# Set password for tc and root so SSH works reliably
echo "tc:piCore" | chpasswd 2>/dev/null || true
echo "root:piCore" | chpasswd 2>/dev/null || true

# Import authorized_keys from boot partition if present
mount /mnt/mmcblk0p1 2>/dev/null
if [ -f /mnt/mmcblk0p1/authorized_keys ]; then
	mkdir -p /home/tc/.ssh /root/.ssh
	cp /mnt/mmcblk0p1/authorized_keys /home/tc/.ssh/authorized_keys
	cp /mnt/mmcblk0p1/authorized_keys /root/.ssh/authorized_keys
	chmod 600 /home/tc/.ssh/authorized_keys /root/.ssh/authorized_keys
	chown -R tc:staff /home/tc/.ssh
fi

[ -x /usr/local/etc/init.d/openssh ] && /usr/local/etc/init.d/openssh start

# If a startup.sh override exists on the boot partition, run it, otherwise run built-in
if [ -f /mnt/mmcblk0p1/startup.sh ]; then
	/bin/sh /mnt/mmcblk0p1/startup.sh &
else
	/usr/bin/startup.sh &
fi
EOF
chmod +x opt/bootlocal.sh

# Whitelist files for persistence during license activation
cat << 'EOF' > opt/.filetool.lst
opt
home
root
etc
usr/bin/Pianoteq
usr/local/etc/ssh
EOF

cd /pianoberry/pianoberry

# Load pianoberry rootfs instead of the original one
sed -i 's/rootfs-piCore64-15\.0/rootfs-pianoberry/g' p1_dir/config.txt

# Add Pianoberry default configs to pi/config.txt
cat <<EOF >> p1_dir/config.txt

[PIANOBERRY]
pianoteq_serial=
pianoteq_initial_preset=NY Steinway D Player
EOF

echo "Creating the image. This may take a while..."

# Repack the rootfs
cd tempdir
find . | cpio -o -H newc | gzip > ../rootfs-pianoberry.gz
cd /pianoberry/pianoberry
advdef -z4 rootfs-pianoberry.gz
rm -f p1_dir/rootfs-piCore64-15.0.gz
cp rootfs-pianoberry.gz p1_dir/

echo "Assembling disk partitions in userspace..."

# 1. Build Partition 1: FAT32 (196 MiB = 401408 sectors * 512 bytes)
dd if=/dev/zero of=p1.fat bs=512 count=401408 status=none
mkfs.vfat -F 32 -n pianoberry p1.fat >/dev/null

export MTOOLS_SKIP_CHECK=1
(
	cd p1_dir
	for item in *; do
		mcopy -i ../p1.fat -s "$item" ::
	done
	for item in .*; do
		[ "$item" = "." ] || [ "$item" = ".." ] || mcopy -i ../p1.fat -s "$item" ::
	done
)

# 2. Build Partition 2: ext4 (119 MiB)
mke2fs -t ext4 -L data -d p2_dir p2.ext4 119M >/dev/null 2>&1

# 3. Assemble complete MBR image (320 MiB = 655360 sectors)
dd bs=512 seek=655359 of=pianoberry.img < /dev/null status=none
parted --script pianoberry.img \
	mklabel msdos \
	mkpart primary fat32 8192s 409599s \
	mkpart primary ext4 409600s 100%

# Write Partition 1 at sector 8192 and Partition 2 at sector 409600
dd if=p1.fat of=pianoberry.img bs=512 seek=8192 conv=notrunc status=none
dd if=p2.ext4 of=pianoberry.img bs=512 seek=409600 conv=notrunc status=none

rm -f p1.fat p2.ext4
rm -rf p1_dir p2_dir tempdir rootfs-pianoberry.gz

echo "Pianoberry image info:"
fdisk -l pianoberry.img

# Delete previous zip if it exists
if [ -f "/build/pianoberry.img.zip" ]; then
    rm /build/pianoberry.img.zip
fi

# Compress and copy the image to the host
zip -9 /build/pianoberry.img.zip pianoberry.img
